[
  {
    "id": "tab-dependency-monitoring",
    "type": "tab",
    "label": "Dependency monitoring",
    "disabled": false,
    "info": "Explicit status and error paths for MQTT and InfluxDB. No actuator output exists in this seed."
  },
  {
    "id": "comment-boundary",
    "type": "comment",
    "z": "tab-dependency-monitoring",
    "name": "Home Assistant remains final actuation authority; use automation/request only",
    "info": "Never add a direct edsys/v1/command output to this project.",
    "x": 380,
    "y": 40,
    "wires": []
  },
  {
    "id": "mqtt-tls",
    "type": "tls-config",
    "name": "Mosquitto mutual TLS",
    "cert": "/run/secrets/mqtt_client_cert",
    "key": "/run/secrets/mqtt_client_key",
    "ca": "/run/secrets/automation_ca_cert",
    "certname": "",
    "keyname": "",
    "caname": "",
    "servername": "mosquitto",
    "verifyservercert": true,
    "alpnprotocol": ""
  },
  {
    "id": "cfg-mqtt-authoritative",
    "type": "mqtt-broker",
    "name": "Authoritative Mosquitto",
    "broker": "mosquitto",
    "port": "8884",
    "tls": "mqtt-tls",
    "clientid": "nodered-edcore-automation",
    "autoConnect": true,
    "usetls": true,
    "protocolVersion": "5",
    "keepalive": "60",
    "cleansession": true,
    "autoUnsubscribe": true,
    "birthTopic": "edsys/v1/availability/edcore-automation/nodered/mqtt",
    "birthQos": "1",
    "birthPayload": "{\"schema\":\"edsys.availability.v1\",\"status\":\"online\",\"source\":\"nodered\"}",
    "birthMsg": {},
    "closeTopic": "edsys/v1/availability/edcore-automation/nodered/mqtt",
    "closeQos": "1",
    "closePayload": "{\"schema\":\"edsys.availability.v1\",\"status\":\"offline\",\"source\":\"nodered\"}",
    "closeMsg": {},
    "willTopic": "edsys/v1/availability/edcore-automation/nodered/mqtt",
    "willQos": "1",
    "willPayload": "{\"schema\":\"edsys.availability.v1\",\"status\":\"offline\",\"source\":\"nodered\"}",
    "willMsg": {}
  },
  {
    "id": "mqtt-availability-in",
    "type": "mqtt in",
    "z": "tab-dependency-monitoring",
    "name": "Dependency availability events",
    "topic": "edsys/v1/availability/#",
    "qos": "1",
    "datatype": "utf8",
    "broker": "cfg-mqtt-authoritative",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 180,
    "y": 120,
    "wires": [["availability-json"]]
  },
  {
    "id": "availability-json",
    "type": "json",
    "z": "tab-dependency-monitoring",
    "name": "Parse bounded availability JSON",
    "property": "payload",
    "action": "obj",
    "pretty": false,
    "x": 470,
    "y": 120,
    "wires": [["availability-debug"]]
  },
  {
    "id": "availability-debug",
    "type": "debug",
    "z": "tab-dependency-monitoring",
    "name": "Availability audit (metadata only)",
    "active": true,
    "tosidebar": false,
    "console": true,
    "tostatus": false,
    "complete": "topic",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 790,
    "y": 120,
    "wires": []
  },
  {
    "id": "mqtt-status",
    "type": "status",
    "z": "tab-dependency-monitoring",
    "name": "MQTT dependency status",
    "scope": ["mqtt-availability-in", "dependency-status-out"],
    "x": 170,
    "y": 190,
    "wires": [["normalise-mqtt-status", "mqtt-health-state"]]
  },
  {
    "id": "normalise-mqtt-status",
    "type": "function",
    "z": "tab-dependency-monitoring",
    "name": "Normalize MQTT status",
    "func": "const text = (msg.status && msg.status.text) || 'unknown';\nconst connected = text === 'connected' || text.endsWith('.status.connected');\nmsg.topic = 'edsys/v1/availability/edcore-automation/nodered/mqtt-dependency';\nmsg.qos = 1;\nmsg.retain = false;\nmsg.payload = {schema:'edsys.availability.v1', status:connected ? 'online' : 'degraded', source:'nodered', dependency:'mosquitto', detail:text, ts:new Date().toISOString()};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 450,
    "y": 190,
    "wires": [["dependency-status-out", "dependency-status-debug"]]
  },
  {
    "id": "dependency-status-out",
    "type": "mqtt out",
    "z": "tab-dependency-monitoring",
    "name": "Publish dependency status (never retained)",
    "topic": "",
    "qos": "1",
    "retain": "false",
    "respTopic": "",
    "contentType": "application/json",
    "userProps": "",
    "correl": "",
    "expiry": "",
    "broker": "cfg-mqtt-authoritative",
    "x": 800,
    "y": 180,
    "wires": []
  },
  {
    "id": "mqtt-health-state",
    "type": "function",
    "z": "tab-dependency-monitoring",
    "name": "Write broker connection health",
    "func": "const text = (msg.status && msg.status.text) || '';\nconst connected = text === 'connected' || text.endsWith('.status.connected');\nmsg.payload = connected ? 'connected\\n' : 'not-connected\\n';\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 470,
    "y": 235,
    "wires": [["mqtt-health-file"]]
  },
  {
    "id": "mqtt-health-file",
    "type": "file",
    "z": "tab-dependency-monitoring",
    "name": "Broker health state",
    "filename": "/data/.edsys-health/mqtt.status",
    "filenameType": "str",
    "appendNewline": false,
    "createDir": true,
    "overwriteFile": "true",
    "encoding": "none",
    "x": 790,
    "y": 260,
    "wires": [[]]
  },
  {
    "id": "dependency-status-debug",
    "type": "debug",
    "z": "tab-dependency-monitoring",
    "name": "Dependency status fallback log",
    "active": true,
    "tosidebar": false,
    "console": true,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 800,
    "y": 220,
    "wires": []
  },
  {
    "id": "influx-health-tls",
    "type": "tls-config",
    "name": "InfluxDB private CA",
    "cert": "",
    "key": "",
    "ca": "/run/secrets/automation_ca_cert",
    "certname": "",
    "keyname": "",
    "caname": "",
    "servername": "influxdb",
    "verifyservercert": true,
    "alpnprotocol": ""
  },
  {
    "id": "influx-health-trigger",
    "type": "inject",
    "z": "tab-dependency-monitoring",
    "name": "Check InfluxDB every 60s",
    "props": [],
    "repeat": "60",
    "crontab": "",
    "once": true,
    "onceDelay": "5",
    "topic": "",
    "x": 180,
    "y": 290,
    "wires": [["influx-health-request"]]
  },
  {
    "id": "influx-health-request",
    "type": "http request",
    "z": "tab-dependency-monitoring",
    "name": "InfluxDB /health (5s timeout)",
    "method": "GET",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "https://influxdb:8086/health",
    "tls": "influx-health-tls",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "x": 480,
    "y": 290,
    "wires": [["influx-health-normalize"]]
  },
  {
    "id": "influx-health-normalize",
    "type": "function",
    "z": "tab-dependency-monitoring",
    "name": "Normalize InfluxDB health",
    "func": "const ok = msg.statusCode === 200 && msg.payload && msg.payload.status === 'pass';\nmsg.topic = 'edsys/v1/availability/edcore-automation/nodered/influxdb-dependency';\nmsg.qos = 1;\nmsg.retain = false;\nmsg.payload = {schema:'edsys.availability.v1', status:ok ? 'online' : 'degraded', source:'nodered', dependency:'influxdb', detail:ok ? 'health-pass' : 'health-failed', ts:new Date().toISOString()};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 780,
    "y": 290,
    "wires": [["dependency-status-out", "dependency-status-debug"]]
  },
  {
    "id": "influx-status",
    "type": "status",
    "z": "tab-dependency-monitoring",
    "name": "Influx HTTP node status",
    "scope": ["influx-health-request"],
    "x": 180,
    "y": 350,
    "wires": [["dependency-status-debug"]]
  },
  {
    "id": "dependency-catch",
    "type": "catch",
    "z": "tab-dependency-monitoring",
    "name": "Catch every dependency error",
    "scope": ["availability-json", "influx-health-request", "influx-health-normalize", "normalise-mqtt-status"],
    "uncaught": false,
    "x": 190,
    "y": 410,
    "wires": [["error-metadata-only"]]
  },
  {
    "id": "error-metadata-only",
    "type": "function",
    "z": "tab-dependency-monitoring",
    "name": "Strip payload from error log",
    "func": "msg.payload = {source:(msg.error && msg.error.source && msg.error.source.name) || 'unknown', message:(msg.error && msg.error.message) || 'dependency error', ts:new Date().toISOString()};\ndelete msg.error;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 490,
    "y": 410,
    "wires": [["dependency-error-debug"]]
  },
  {
    "id": "dependency-error-debug",
    "type": "debug",
    "z": "tab-dependency-monitoring",
    "name": "Dependency error path",
    "active": true,
    "tosidebar": false,
    "console": true,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 790,
    "y": 410,
    "wires": []
  },
  {
    "id": "tab-orchestration-template",
    "type": "tab",
    "label": "Reviewed orchestration template",
    "disabled": true,
    "info": "Disabled fail-closed template. Copy only after adding replay fixtures, timeouts, dependency status, and acknowledgment handling."
  },
  {
    "id": "template-comment",
    "type": "comment",
    "z": "tab-orchestration-template",
    "name": "Template intentionally has no active inputs or outputs",
    "info": "A future flow may publish a validated request to edsys/v1/automation/request/nodered. It must never publish directly to an actuator topic.",
    "x": 350,
    "y": 80,
    "wires": []
  }
]
