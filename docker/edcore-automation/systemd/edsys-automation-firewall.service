[Unit]
Description=EdSys automation guest firewall
DefaultDependencies=no
Before=network-pre.target docker.service
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/local/sbin/edsys-automation-source-guard --coherent
ExecStart=/usr/local/sbin/edsys-automation-firewall
ExecReload=/usr/local/sbin/edsys-automation-firewall

[Install]
WantedBy=multi-user.target
