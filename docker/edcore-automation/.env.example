# Fixed production identity. Provisioning/rebuild must still pass the
# fail-closed VMID 324 and 192.168.50.82 availability preflight.
LAN_BIND_ADDRESS=192.168.50.82
AUTOMATION_DNS_NAME=edcore-automation.edsys.local

# These identifiers are not secrets. Keep real credentials in root-owned
# files under /etc/edsys-secrets/edcore-automation only.
NODE_RED_ADMIN_USERNAME=admin
INFLUXDB_INIT_USERNAME=edsys-influx-admin
INFLUXDB_ORG=edsys
INFLUXDB_BUCKET=automation_selected
INFLUXDB_RETENTION=30d

# The command gate is fail-closed. Policy changes are reviewed in Git at
# runtime/config/policy.json; this variable only controls clock tolerance.
AUTOMATION_MAX_CLOCK_SKEW_SECONDS=30
