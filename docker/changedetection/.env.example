# Real env and datastore are private runtime files, never repository material.
# Use image IDs from images.lock.json after verifying local image/archive hashes.
CHANGEDETECTION_PROJECT_NAME=edsys-changedetection
CHANGEDETECTION_CONTAINER_NAME=edsys-changedetection
CHANGEDETECTION_BROWSER_CONTAINER_NAME=edsys-changedetection-browser
CHANGEDETECTION_EGRESS_CONTAINER_NAME=edsys-changedetection-egress
CHANGEDETECTION_IMAGE=edsys/changedetection-private:0.60.10-edsys1
CHANGEDETECTION_BROWSER_IMAGE=edsys/changedetection-browser:156.0.8078.73-edsys1
CHANGEDETECTION_EGRESS_IMAGE=edsys/changedetection-private:0.60.10-edsys1
CHANGEDETECTION_UID=1000
CHANGEDETECTION_GID=1000
CHANGEDETECTION_DATA_DIR=/mnt/ai-store/edsys-private-services/changedetection
CHANGEDETECTION_BASE_URL=https://owner-private-host.example.invalid:8453
CHANGEDETECTION_OLLAMA_BASE=http://existing-local-ollama.example.invalid:11434
# Replace these documentation addresses with this machine's real addresses.
# Own Tailnet destinations are excluded entirely to avoid inheriting its Serve identity.
CHANGEDETECTION_DENY_HOSTS=["192.0.2.254","2001:db8::254"]
CHANGEDETECTION_PROTECTED_HOSTS=["192.0.2.50"]
CHANGEDETECTION_PROTECTED_PORTS=[443,2283,8443,8444,8445,8446,8447,8448,8449,8450,8451,8452,8453]

# App and browser cannot address each other directly. Gateway IP forwarding is off.
CHANGEDETECTION_SUBNET=10.254.230.16/28
CHANGEDETECTION_APP_IP=10.254.230.18
CHANGEDETECTION_EGRESS_APP_IP=10.254.230.19
CHANGEDETECTION_BROWSER_SUBNET=10.254.230.112/28
CHANGEDETECTION_BROWSER_IP=10.254.230.114
CHANGEDETECTION_EGRESS_BROWSER_IP=10.254.230.115
CHANGEDETECTION_EGRESS_SUBNET=10.254.230.96/28
CHANGEDETECTION_EGRESS_IP=10.254.230.98
