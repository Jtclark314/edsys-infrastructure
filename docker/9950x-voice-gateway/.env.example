# The live file is /etc/edsys-secrets/voice-gateway/deploy.env (0600 root:root).
# Use the immutable local image ID produced from the reviewed private source.
# A private-registry repo@sha256 digest is also valid when registry publishing is available.
EDSYS_VOICE_GATEWAY_IMAGE=sha256:CHANGE_ME
EDSYS_VOICE_GATEWAY_PULL_POLICY=never
EDSYS_VOICE_GATEWAY_LAN_IP=192.168.50.50
EDSYS_VOICE_GATEWAY_PORT=8055
EDSYS_VOICE_GATEWAY_METRICS_PORT=8056
