[Unit]
Description=EdSys Voice Gateway source firewall
DefaultDependencies=no
Before=network-pre.target docker.service edsys-voice-gateway-compose.service
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/edsys-voice-gateway-firewall
ExecReload=/usr/local/sbin/edsys-voice-gateway-firewall

[Install]
WantedBy=multi-user.target
