def service_protocol(service: dict[str, Any]):
    raw_port = service.get("port")
    raw_protocol = str(service.get("protocol") or "").lower()
    if isinstance(raw_port, int):
        port = raw_port
    elif isinstance(raw_port, str):
        match = re.fullmatch(r"(\d+)(?:/(tcp|udp|sctp))?", raw_port.strip(), re.I)
        if not match:
            return None
        port = int(match.group(1))
        if match.group(2):
            raw_protocol = match.group(2).lower()
    else:
        return None
    tokens = {token for token in re.split(r"[^a-z]+", raw_protocol) if token}
    if "udp" in tokens and "tcp" not in tokens:
        protocol = "udp"
    elif "sctp" in tokens and not ({"tcp", "udp"} & tokens):
        protocol = "sctp"
    elif "tcp" in tokens or tokens & {"http", "https", "ssh", "mcp", "smb", "wyoming"}:
        protocol = "tcp"
    else:
        protocol = "tcp"
    return protocol, port


def add_services(plan: Plan, services: dict[str, Any], network: dict[str, Any]):
    physical = {op["payload"].get("name"): op["key"] for op in plan.operations if op.get("endpoint") == "dcim/devices/"}
    vm_name_map = {str(item.get("name")): f"vm:{item['vmid']}" for item in network.get("proxmox_resources", [])}
    vm_ip_map = {str(item.get("guest_ip")): f"vm:{item['vmid']}" for item in network.get("proxmox_resources", []) if item.get("guest_ip")}
    vm_name_map.update({"netbox": "vm:323"})
    vm_ip_map["192.168.50.81"] = "vm:323"
    # Service-catalog host aliases which intentionally differ from Proxmox guest names.
    vm_name_map["arr-server"] = "vm:200"
    for item in services.get("services", []):
        parsed = service_protocol(item)
        if not parsed:
            continue
        is_retired = any(
            token in str(item.get("status", "")).lower()
            for token in ("retired", "destroyed")
        )
        protocol, port = parsed
        host = str(item.get("host") or "")
        parent = physical.get(host) or vm_name_map.get(host) or vm_ip_map.get(str(item.get("ip") or ""))
        if not parent or host in {"multiple", "external", "cloud"}:
            continue
        is_vm = parent.startswith("vm:")
        parent_type = "virtualization.virtualmachine" if is_vm else "dcim.device"
        payload = {
            "parent_object_type": parent_type, "parent_object_id": ref(parent), "name": item["name"][:100],
            "protocol": protocol, "ports": [port],
            "description": f"{item.get('runtime', '')}; {item.get('url') or ''}"[:200].strip(),
            "comments": str(item.get("notes") or "")[:5000],
            "tags": inventory_tags(retired=is_retired),
            "custom_fields": cf_values(
                item.get("source", "EdSys service catalog"), item.get("last_verified"), item.get("confidence", "medium"), item,
                last_verified=(item.get("last_verified") or TODAY)[:10], criticality=str(item.get("criticality") or "")[:100],
                backup_requirement=str(item.get("backup_required") or "")[:200], management_method=str(item.get("runtime") or "")[:200], retired=is_retired,
            ),
        }
        plan.upsert(f"service:{slug(item['name'])}", "ipam/services/", {"name": item["name"][:100]}, payload)


def load_yaml(path: str):
    with open(path, encoding="utf-8") as handle:
        loaded = yaml.safe_load(handle)
    # Normalize YAML timestamps/dates into deterministic ISO strings so plan
    # serialization and source hashing never depend on Python object types.
    return json.loads(canonical(loaded))


def ssh_json(host: str, command: str):
    prefix = []
    if os.geteuid() == 0 and os.environ.get("SUDO_USER") not in {None, "", "root"}:
        prefix = ["sudo", "-H", "-u", os.environ["SUDO_USER"], "--"]
    result = subprocess.run(
        prefix + ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", host, command],
        check=True, text=True, capture_output=True, timeout=90,
    )
    return json.loads(result.stdout)


def ssh_argv(host: str, command: str, *, strict=True):
    prefix = []
    if os.geteuid() == 0 and os.environ.get("SUDO_USER") not in {None, "", "root"}:
        prefix = ["sudo", "-H", "-u", os.environ["SUDO_USER"], "--"]
    return prefix + [
        "ssh", "-o", "BatchMode=yes",
        "-o", f"StrictHostKeyChecking={'yes' if strict else 'accept-new'}",
        "-o", "ConnectTimeout=10", host, command,
    ]


def discover_proxmox(config: dict[str, Any]):
    primary = config["proxmox_hosts"][0]
    resources = ssh_json(primary, "pvesh get /cluster/resources --type vm --output-format json")
    result = []
    for item in resources:
        if item.get("template"):
            continue
        node = item.get("node")
        vmid = int(item["vmid"])
        kind = item.get("type", "qemu")
        vm_config = ssh_json(primary, f"pvesh get /nodes/{node}/{kind}/{vmid}/config --output-format json")
        net0 = str(vm_config.get("net0") or "")
        mac_match = re.search(r"(?:^|,)(?:virtio|e1000|rtl8139|vmxnet3)=([0-9A-F:]{17})", net0, re.I)
        bridge_match = re.search(r"(?:^|,)bridge=([^,]+)", net0)
        disks = [
            str(value)
            for key, value in sorted(vm_config.items())
            if re.fullmatch(r"(?:ide|sata|scsi|virtio)\d+", key)
            and "media=cdrom" not in str(value)
            and "cloudinit" not in str(value)
        ]
        result.append({
            "vmid": vmid, "name": item.get("name"), "node": node, "type": kind,
            "status": item.get("status"), "cores": vm_config.get("cores") or item.get("maxcpu"),
            "memory_mb": vm_config.get("memory") or int(item.get("maxmem", 0) / 1024 / 1024),
            "onboot": bool(vm_config.get("onboot", 0)), "startup": vm_config.get("startup"),
            "mac": mac_match.group(1).upper() if mac_match else None,
            "bridge": bridge_match.group(1) if bridge_match else None,
            "disks": disks,
            "source": "live Proxmox cluster and guest configuration discovery",
            "confidence": "high", "last_verified": TODAY,
        })
    return sorted(result, key=lambda item: item["vmid"])


def discover_proxmox_hardware(config: dict[str, Any]):
    probe = r'''
import json, pathlib, subprocess
def read(path):
    try: return pathlib.Path(path).read_text(errors="replace").strip()
    except Exception: return ""
def run(*args):
    try: return json.loads(subprocess.run(args, check=True, text=True, capture_output=True, timeout=30).stdout)
    except Exception: return None
links = run("ip", "-j", "link", "show") or []
block = run("lsblk", "-J", "-b", "-o", "NAME,MODEL,SERIAL,SIZE,TYPE,TRAN") or {"blockdevices": []}
print(json.dumps({
  "hostname": read("/etc/hostname"),
  "system_vendor": read("/sys/class/dmi/id/sys_vendor"),
  "product_name": read("/sys/class/dmi/id/product_name"),
  "product_serial": read("/sys/class/dmi/id/product_serial"),
  "board_name": read("/sys/class/dmi/id/board_name"),
  "board_serial": read("/sys/class/dmi/id/board_serial"),
  "pve_version": subprocess.run(["pveversion"], text=True, capture_output=True, timeout=15).stdout.strip(),
  "disks": block.get("blockdevices", []),
  "links": [{"name": x.get("ifname"), "mac": x.get("address"), "type": x.get("link_type"), "state": x.get("operstate")} for x in links],
}))
'''
    records = []
    for host in config.get("proxmox_hosts", []):
        # Proxmox aliases use the dedicated key-only root management identity;
        # minimal PVE installs do not ship sudo.
        command = "python3 -c " + shlex.quote(probe)
        proc = subprocess.run(ssh_argv(host, command), check=True, text=True, capture_output=True, timeout=90)
        item = json.loads(proc.stdout)
        item["requested_host"] = host
        item["observed_date"] = TODAY
        records.append(item)
    return sorted(records, key=lambda item: item.get("hostname") or item.get("requested_host"))


def useful_serial(value: Any):
    cleaned = str(value or "").strip()
    if not cleaned or cleaned.lower() in {"none", "unknown", "default string", "to be filled by o.e.m."}:
        return ""
    return cleaned[:100]


