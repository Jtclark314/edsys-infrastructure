def device_category_role(category: str | None, role: str | None):
    value = (category or role or "infrastructure").lower()
    if "network" in value or "router" in value or "switch" in value or "wireless" in value:
        return "network"
    if "client" in value or "laptop" in value or "tablet" in value:
        return "endpoint"
    if "server" in value or "compute" in value or "host" in value:
        return "compute"
    return "infrastructure"


