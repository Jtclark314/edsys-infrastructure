def address_with_mask(value: str):
    if "/" in value:
        return value
    ip = ipaddress.ip_address(value)
    if ip.is_loopback or ip.version == 6 or value.startswith("100."):
        return f"{value}/{32 if ip.version == 4 else 128}"
    return f"{value}/24"


def valid_ip(value: Any):
    if not isinstance(value, str) or value.lower() in {"none", "dhcp", "unknown", "to be confirmed"}:
        return False
    try:
        ipaddress.ip_interface(address_with_mask(value))
        return True
    except ValueError:
        return False


def stable_inventory_ip(value: Any):
    """Exclude host-local bridge addresses which are duplicated by design."""
    if not valid_ip(value):
        return False
    address = ipaddress.ip_interface(address_with_mask(value)).ip
    if address.version == 4 and ipaddress.ip_address("172.16.0.0") <= address <= ipaddress.ip_address("172.31.255.255"):
        return False
    return True


def add_network_inventory(plan: Plan, network: dict[str, Any]):
    vm_ips = {item.get("guest_ip") for item in network.get("proxmox_resources", []) if item.get("guest_ip")}
    vm_names = {item.get("name") for item in network.get("proxmox_resources", [])}
    vm_names.update({"node1-services", "family-services", "arr-server", "edrouter-node0", "arr-vm", "netbox"})

    # A retired identity may retain the same historical address now owned by a
    # fresh active identity (for example pve-edcore -> pve-node3).  NetBox does
    # not permit an IP address that is a current primary to be reassigned even
    # transiently.  Precompute active physical-device addresses so the retired
    # record remains offline/history-only without attempting to steal the live
    # assignment earlier in the deterministic plan.
    active_device_addresses: set[str] = set()
    for candidate in network.get("devices", []):
        candidate_retired = any(
            token in str(candidate.get("status", "")).lower()
            for token in ("retired", "destroyed")
        )
        if candidate_retired or candidate.get("hostname") in vm_names or candidate.get("ip") in vm_ips:
            continue
        for value in [candidate.get("ip"), *[item.get("ip") for item in candidate.get("interfaces") or []]]:
            if stable_inventory_ip(value):
                active_device_addresses.add(address_with_mask(value))

    plan.upsert(
        "vlan:1", "ipam/vlans/", {"vid": 1, "name": "DEFAULT_VLAN"},
        {"vid": 1, "name": "DEFAULT_VLAN", "status": "active", "site": ref("site:edsys-home"), "tenant": ref("tenant:edsys"), "description": "EdSys core untagged LAN"},
    )
    for subnet in network.get("subnets", []):
        status = "active" if subnet.get("status") not in {"retired", "deprecated"} else "deprecated"
        plan.upsert(
            f"prefix:{subnet['cidr']}", "ipam/prefixes/", {"prefix": subnet["cidr"]},
            {
                "prefix": subnet["cidr"], "status": status, "tenant": ref("tenant:edsys"),
                "description": f"{subnet.get('name', 'EdSys subnet')}; {subnet.get('notes', '')}"[:200],
                "tags": inventory_tags(),
                "custom_fields": cf_values(subnet.get("source", "EdSys network map"), subnet.get("last_verified"), subnet.get("confidence", "medium"), subnet),
            },
        )
        if subnet.get("dhcp_range") and subnet["cidr"] == "192.168.50.0/24":
            start, end = [part.strip() for part in re.split(r"\s*(?:-|to)\s*", subnet["dhcp_range"], maxsplit=1)]
            plan.upsert(
                "ip-range:core-dhcp", "ipam/ip-ranges/", {"start_address": start, "end_address": end},
                {"start_address": start, "end_address": end, "status": "active", "tenant": ref("tenant:edsys"), "description": "EdSys router DHCP pool"},
            )

    seen_macs: set[str] = set()
    host_local_addresses: set[str] = set()
    for device in network.get("devices", []):
        name = device["hostname"]
        if name in vm_names or device.get("ip") in vm_ips:
            continue
        category = device_category_role(device.get("category"), device.get("role"))
        key = f"device:{name}"
        is_tbc = bool(device.get("verify_live")) or str(device.get("confidence", "")).lower() not in {"high", "verified"}
        is_retired = any(
            token in str(device.get("status", "")).lower()
            for token in ("retired", "destroyed")
        )
        tag_refs = inventory_tags(to_be_confirmed=is_tbc, retired=is_retired)
        payload = {
            "name": name,
            "device_type": ref(f"device-type:{category}"),
            "role": ref(f"role:{category}"),
            "site": ref("site:edsys-home"),
            "location": ref("location:network-core"),
            "tenant": ref("tenant:edsys"),
            "status": "offline" if is_retired else "active",
            "description": str(device.get("role") or device.get("category") or "EdSys managed device")[:200],
            "comments": f"Management: {', '.join(device.get('management_urls') or [])}\n\n{device.get('notes', '')}"[:5000],
            "tags": tag_refs,
            "custom_fields": cf_values(
                device.get("source", "EdSys network map"), device.get("last_verified"), device.get("confidence", "medium"), device,
                last_verified=(device.get("last_verified") or TODAY)[:10], management_method="EdSys reviewed inventory and read-only discovery", retired=is_retired,
            ),
        }
        if name in set(network.get("proxmox_cluster", {}).get("nodes", [])):
            payload["cluster"] = ref("cluster:gadgetlab")
        plan.upsert(key, "dcim/devices/", {"name": name}, payload)
        # A retired device must not keep a primary IP.  Clearing the pointer
        # before IP-address upserts also permits a reviewed address reuse (for
        # example, a fresh host identity on the same physical management IP)
        # without NetBox rejecting the reassignment mid-plan.
        if is_retired:
            plan.patch_ref(
                f"clear-primary-ip:{name}", key,
                {"primary_ip4": None, "primary_ip6": None},
            )

        interfaces = device.get("interfaces") or [{"name": "management0", "ip": device.get("ip"), "mac": device.get("mac"), "state": "UP"}]
        primary_ip_ref = None
        for index, interface in enumerate(interfaces):
            ifname = str(interface.get("name") or f"interface{index}")
            ifkey = f"interface:{name}:{ifname}"
            plan.upsert(
                ifkey, "dcim/interfaces/", {"device_id": ref(key), "name": ifname},
                {
                    "device": ref(key), "name": ifname, "type": "other",
                    "enabled": not is_retired and str(interface.get("state", "UP")).upper() != "DOWN",
                    "description": str(interface.get("notes") or "Observed interface")[:200],
                    "tags": tag_refs,
                    "custom_fields": cf_values(device.get("source", "EdSys network map"), device.get("last_verified"), device.get("confidence", "medium"), interface, retired=is_retired),
                },
            )
            mac = interface.get("mac") or (device.get("mac") if index == 0 else None)
            normalized_mac = str(mac).upper() if mac else None
            if normalized_mac and normalized_mac not in seen_macs:
                seen_macs.add(normalized_mac)
                plan.upsert(
                    f"mac:{name}:{ifname}", "dcim/mac-addresses/", {"mac_address": mac},
                    {"mac_address": mac, "assigned_object_type": "dcim.interface", "assigned_object_id": ref(ifkey), "description": "Observed management MAC"},
                )
            ip = interface.get("ip")
            if valid_ip(ip) and not stable_inventory_ip(ip):
                host_local_addresses.add(address_with_mask(ip))
            address_reused_by_active = is_retired and stable_inventory_ip(ip) and address_with_mask(ip) in active_device_addresses
            if stable_inventory_ip(ip) and not address_reused_by_active:
                ipkey = f"ip:{address_with_mask(ip)}"
                plan.upsert(
                    ipkey, "ipam/ip-addresses/", {"address": address_with_mask(ip)},
                    {
                        "address": address_with_mask(ip), "status": "deprecated" if is_retired else "active", "tenant": ref("tenant:edsys"),
                        "assigned_object_type": "dcim.interface", "assigned_object_id": ref(ifkey),
                        "dns_name": f"{name}.edsys.local" if str(ip).startswith("192.168.50.") and not is_retired else "",
                        "description": "Observed interface address",
                        "tags": tag_refs,
                        "custom_fields": cf_values(device.get("source", "EdSys network map"), device.get("last_verified"), device.get("confidence", "medium"), {"device": name, "interface": interface}, retired=is_retired),
                    },
                )
                if ip == device.get("ip") or (primary_ip_ref is None and str(ip).startswith("192.168.50.")):
                    primary_ip_ref = ipkey
        retired_primary_reused = (
            is_retired
            and valid_ip(device.get("ip"))
            and address_with_mask(device["ip"]) in active_device_addresses
        )
        if device.get("ip") and valid_ip(device["ip"]) and primary_ip_ref is None and not retired_primary_reused:
            ifkey = f"interface:{name}:management0"
            if not any(op["key"] == ifkey for op in plan.operations):
                plan.upsert(
                    ifkey, "dcim/interfaces/", {"device_id": ref(key), "name": "management0"},
                    {
                        "device": ref(key), "name": "management0", "type": "other", "enabled": not is_retired,
                        "description": "Reviewed primary management interface", "tags": tag_refs,
                        "custom_fields": cf_values(
                            device.get("source", "EdSys network map"), device.get("last_verified"),
                            device.get("confidence", "medium"), {"device": name, "interface": "management0"}, retired=is_retired,
                        ),
                    },
                )
            primary_ip_ref = f"ip:{address_with_mask(device['ip'])}"
            plan.upsert(
                primary_ip_ref, "ipam/ip-addresses/", {"address": address_with_mask(device["ip"])},
                {
                    "address": address_with_mask(device["ip"]), "status": "deprecated" if is_retired else "active", "tenant": ref("tenant:edsys"),
                    "assigned_object_type": "dcim.interface", "assigned_object_id": ref(ifkey),
                    "dns_name": "" if is_retired else f"{name}.edsys.local", "description": "Primary management address", "tags": tag_refs,
                    "custom_fields": cf_values(
                        device.get("source", "EdSys network map"), device.get("last_verified"),
                        device.get("confidence", "medium"), {"device": name, "address": device["ip"]}, retired=is_retired,
                    ),
                },
            )
        if primary_ip_ref and not is_retired:
            plan.patch_ref(f"primary-ip:{name}", key, {"primary_ip4": ref(primary_ip_ref)})

    # Retain, but explicitly de-authorize, host-local Docker bridge addresses
    # that were present in older reviewed maps. They are duplicated by design
    # and must not compete for globally unique operational IP assignments.
    for address in sorted(host_local_addresses):
        plan.upsert(
            f"stale-host-local-ip:{address}", "ipam/ip-addresses/", {"address": address},
            {
                "address": address,
                "status": "deprecated",
                "assigned_object_type": None,
                "assigned_object_id": None,
                "description": "Host-local Docker bridge address; retained as stale evidence only",
                "tags": [ref("tag:discovered"), ref("tag:retired")],
                "custom_fields": {
                    "source": "EdSys NetBox reconciliation",
                    "last_observed": TODAY,
                    "confidence": "high",
                    "discovered": True,
                    "authoritative": False,
                    "retired": True,
                },
            },
        )


def parse_disk_size_mb(value: str):
    match = re.search(r"size=(\d+(?:\.\d+)?)([KMGT])", value, re.I)
    if not match:
        return None
    amount = float(match.group(1))
    multiplier = {"K": 1 / 1024, "M": 1, "G": 1024, "T": 1024 * 1024}[match.group(2).upper()]
    return int(amount * multiplier)


