                },
            )


def discover_docker(config: dict[str, Any]):
    records = []
    command = "docker ps --format '{{json .}}'"
    for host in config.get("docker_hosts", []):
        try:
            if host == "localhost":
                proc = subprocess.run(["bash", "-lc", command], check=True, text=True, capture_output=True, timeout=60)
            else:
                proc = subprocess.run(ssh_argv(host, command), check=True, text=True, capture_output=True, timeout=90)
        except Exception as exc:
            records.append({"host": host, "status": "to be confirmed", "error": str(exc)[:300]})
            continue
        for line in proc.stdout.splitlines():
            if not line.strip():
                continue
            item = json.loads(line)
            compose_project = None
            for label in item.get("Labels", "").split(","):
                if label.startswith("com.docker.compose.project="):
                    compose_project = label.split("=", 1)[1]
                    break
            records.append({
                "host": host, "name": item.get("Names"), "image": item.get("Image"),
                "ports": item.get("Ports"), "status": item.get("Status"),
                "compose_project": compose_project,
            })
    return sorted(records, key=lambda item: (item["host"], item.get("name") or ""))


def discover_network(config: dict[str, Any]):
    records = []
    command = "hostname; ip -j address show"
    for host in config.get("network_hosts", []):
        try:
            if host == "localhost":
                proc = subprocess.run(["bash", "-lc", command], check=True, text=True, capture_output=True, timeout=30)
            else:
                proc = subprocess.run(ssh_argv(host, command), check=True, text=True, capture_output=True, timeout=45)
            lines = proc.stdout.splitlines()
            hostname = lines[0].strip()
            interfaces = json.loads("\n".join(lines[1:]))
            stable = []
            for interface in interfaces:
                addresses = [
                    item.get("local")
                    for item in interface.get("addr_info", [])
                    if item.get("scope") in {"global", "link"} and item.get("local")
                ]
                stable.append({
                    "name": interface.get("ifname"), "mac": interface.get("address"),
                    "state": interface.get("operstate"), "addresses": sorted(addresses),
                })
            records.append({"requested_host": host, "hostname": hostname, "interfaces": sorted(stable, key=lambda item: item["name"] or ""), "status": "observed"})
        except Exception as exc:
            records.append({"requested_host": host, "status": "to be confirmed", "error": str(exc)[:300]})

    try:
        status = subprocess.run(["tailscale", "status", "--json"], check=True, text=True, capture_output=True, timeout=30)
        raw = json.loads(status.stdout)
        tailscale_nodes = []
        for item in [raw.get("Self", {})] + list((raw.get("Peer") or {}).values()):
            if not item:
                continue
            tailscale_nodes.append({
                "hostname": item.get("HostName"), "dns_name": item.get("DNSName"),
                "tailscale_ips": sorted(item.get("TailscaleIPs") or []), "online": item.get("Online"),
            })
    except Exception as exc:
        tailscale_nodes = [{"status": "to be confirmed", "error": str(exc)[:300]}]
    return {"hosts": sorted(records, key=lambda item: item["requested_host"]), "tailscale_nodes": sorted(tailscale_nodes, key=lambda item: item.get("hostname") or "")}


def build_plan(command: str, config: dict[str, Any]):
    network = load_yaml(config["network_map"])
    services = load_yaml(config["service_catalog"])
    evidence = {"network_source_hash": source_hash(network), "service_source_hash": source_hash(services)}
    plan = Plan(command, evidence)

    if command in {"bootstrap", "sync-network"}:
        if command == "sync-network":
            plan.evidence["network_discovery"] = discover_network(config)
            live_proxmox = discover_proxmox(config)
            plan.evidence["proxmox"] = live_proxmox
        else:
            live_proxmox = None
        add_foundation(plan)
        add_roles_types(plan, network)
        add_network_inventory(plan, network)
        add_virtualization(plan, network, live_proxmox)
        add_services(plan, services, network)
    elif command == "sync-proxmox":
        live = discover_proxmox(config)
        hardware = discover_proxmox_hardware(config)
        plan.evidence["proxmox"] = live
        plan.evidence["proxmox_hardware"] = hardware
        add_foundation(plan)
        add_roles_types(plan, network)
        add_virtualization(plan, network, live)
        add_proxmox_hardware(plan, hardware)
    elif command == "sync-docker":
        live = discover_docker(config)
        plan.evidence["docker"] = live
        # Container models are deliberately not invented. Discovery remains an evidence
        # report and service custom fields are updated only through reviewed catalog data.
    else:
        raise RuntimeError(f"No mutating plan builder for {command}")
    return plan.as_dict()


def validate_inventory(api: NetBoxAPI):
    endpoints = {
        "devices": "dcim/devices/", "interfaces": "dcim/interfaces/", "ip_addresses": "ipam/ip-addresses/",
        "prefixes": "ipam/prefixes/", "virtual_machines": "virtualization/virtual-machines/",
        "virtual_disks": "virtualization/virtual-disks/", "services": "ipam/services/",
        "inventory_items": "dcim/inventory-items/",
    }
    objects = {name: api.list(path) for name, path in endpoints.items()}
    errors = []
    warnings = []
    for name in ("devices", "virtual_machines"):
        values = [item.get("name") for item in objects[name]]
        duplicates = sorted({value for value in values if value and values.count(value) > 1})
        if duplicates:
            errors.append(f"duplicate {name}: {duplicates}")
    for service in objects["services"]:
        if not service.get("parent"):
            errors.append(f"orphan service: {service.get('name')}")
    for vm in objects["virtual_machines"]:
        if not vm.get("cluster"):
            errors.append(f"VM without cluster: {vm.get('name')}")
        tags = {
            str(tag.get("slug") or tag.get("name") or "").lower()
            for tag in (vm.get("tags") or [])
            if isinstance(tag, dict)
        }
        if not vm.get("primary_ip4") and "benchmark-canary" not in tags:
            errors.append(f"VM without primary IPv4: {vm.get('name')}")
    addresses = [item.get("address") for item in objects["ip_addresses"]]
    duplicates = sorted({address for address in addresses if address and addresses.count(address) > 1})
    if duplicates:
        errors.append(f"duplicate IP addresses: {duplicates}")
    if not AUTHORITATIVE_CUTOVER:
        for name in ("devices", "virtual_machines", "services", "prefixes", "ip_addresses"):
            premature = [
                item.get("display") or item.get("name") or item.get("address") or item.get("prefix")
                for item in objects[name]
                if (item.get("custom_fields") or {}).get("authoritative") is True
            ]
            if premature:
                errors.append(f"premature authoritative flags in {name}: {premature[:10]}")
    stale = sum(
        1 for item in objects["ip_addresses"]
        if (item.get("custom_fields") or {}).get("retired") is True
    )
    if stale:
        warnings.append(f"retained stale/retired IP observations: {stale}")
    required = {"devices": 1, "ip_addresses": 1, "prefixes": 1, "virtual_machines": 8, "services": 1}
    for name, minimum in required.items():
        if len(objects[name]) < minimum:
            errors.append(f"{name} count {len(objects[name])} below required {minimum}")
    return {"ok": not errors, "errors": errors, "warnings": warnings, "counts": {name: len(items) for name, items in objects.items()}}


def sanitized_export(api: NetBoxAPI):
    def nested_name(value):
        if not value:
            return None
        return value.get("name") or value.get("display") or value.get("slug")

    devices = []
    for item in api.list("dcim/devices/"):
        if (item.get("custom_fields") or {}).get("retired") is True:
            continue
        devices.append({
            "name": item.get("name"), "status": item.get("status", {}).get("value") if isinstance(item.get("status"), dict) else item.get("status"),
            "site": nested_name(item.get("site")), "role": nested_name(item.get("role")),
            "device_type": nested_name(item.get("device_type")), "primary_ip4": (item.get("primary_ip4") or {}).get("address"),
        })
    virtual_machines = []
    for item in api.list("virtualization/virtual-machines/"):
        if (item.get("custom_fields") or {}).get("retired") is True:
            continue
        virtual_machines.append({
            "name": item.get("name"), "status": item.get("status", {}).get("value") if isinstance(item.get("status"), dict) else item.get("status"),
            "cluster": nested_name(item.get("cluster")), "site": nested_name(item.get("site")),
            "vcpus": item.get("vcpus"), "memory_mb": item.get("memory"), "primary_ip4": (item.get("primary_ip4") or {}).get("address"),
        })
    prefixes = [{"prefix": item.get("prefix"), "status": (item.get("status") or {}).get("value")} for item in api.list("ipam/prefixes/")]
    services = []
    for item in api.list("ipam/services/"):
        if (item.get("custom_fields") or {}).get("retired") is True:
            continue
        services.append({
            "name": item.get("name"), "parent": nested_name(item.get("parent")),
            "protocol": (item.get("protocol") or {}).get("value") if isinstance(item.get("protocol"), dict) else item.get("protocol"),
            "ports": item.get("ports") or [],
        })
    return {
        "metadata": {
            "title": "EdSys reviewed NetBox inventory snapshot", "generated_date": TODAY,
            "authority": (
                "NetBox operational authority; this reviewed sanitized snapshot may lag live state"
                if AUTHORITATIVE_CUTOVER
                else "Pre-cutover inventory candidate; reviewed YAML catalogs remain authoritative"
            ),
            "safety": "serials, credentials, SSIDs, PSKs, tokens, raw logs, and dynamic clients excluded",
        },
        "devices": sorted(devices, key=lambda item: item["name"] or ""),
        "virtual_machines": sorted(virtual_machines, key=lambda item: item["name"] or ""),
        "prefixes": sorted(prefixes, key=lambda item: item["prefix"] or ""),
        "services": sorted(services, key=lambda item: ((item["parent"] or ""), item["name"] or "")),
    }


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", default="/etc/edsys-netbox-sync/config.yml")
    parser.add_argument("command", choices=COMMANDS)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--dry-run", action="store_true")
    mode.add_argument("--apply", action="store_true")
    parser.add_argument("--confirm-plan-hash")
    parser.add_argument("--output")
    args = parser.parse_args()

    config = load_yaml(args.config)
    state_dir = Path(config.get("state_dir", "/var/lib/edsys-netbox-sync"))
    plan_dir = state_dir / "plans"
    report_dir = state_dir / "reports"
    plan_dir.mkdir(parents=True, exist_ok=True)
    report_dir.mkdir(parents=True, exist_ok=True)
    os.chmod(state_dir, 0o700)
    api = NetBoxAPI(config["netbox_url"], config["token_file"])

    if args.command in {"validate", "reconcile"}:
        result = validate_inventory(api)
        print(yaml.safe_dump(result, sort_keys=True), end="")
        if args.command == "validate" and not result["ok"]:
            return 2
        return 0

    if args.apply:
        if not args.confirm_plan_hash:
            raise RuntimeError("--apply requires the exact --confirm-plan-hash produced by the preceding dry run")
        plan_hash = args.confirm_plan_hash
        plan_path = plan_dir / f"{args.command}-{plan_hash}.json"
        if not plan_path.exists():
            raise RuntimeError(f"Approved plan file does not exist: {plan_path}")
        approved = json.loads(plan_path.read_text(encoding="utf-8"))
        verified_hash = digest({key: value for key, value in approved.items() if key != "created_utc"})
        if verified_hash != plan_hash:
            raise RuntimeError("Approved plan content no longer matches its SHA-256")
        if approved.get("command") != args.command:
            raise RuntimeError("Approved plan command does not match the requested command")
        if args.command == "export":
            output = Path(args.output or config["export_path"])
            output.parent.mkdir(parents=True, exist_ok=True)
            rendered = yaml.safe_dump(approved["snapshot"], sort_keys=False, allow_unicode=True)
            temporary = output.with_suffix(output.suffix + ".tmp")
            temporary.write_text(rendered, encoding="utf-8")
            os.replace(temporary, output)
            print(f"Wrote deterministic sanitized export to {output}")
            return 0
        changes = execute_plan(api, approved)
        report = {"command": args.command, "plan_hash": plan_hash, "applied_utc": dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat(), "changes": changes, "automatic_deletion": False}
        report_path = report_dir / f"{args.command}-{plan_hash}.json"
        report_path.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        os.chmod(report_path, 0o600)
        print(yaml.safe_dump(report, sort_keys=True), end="")
        return 0

    if args.command == "export":
        snapshot = sanitized_export(api)
        plan = {"schema": 1, "command": "export", "snapshot": snapshot}
    else:
        plan = build_plan(args.command, config)

    plan_hash = digest({key: value for key, value in plan.items() if key != "created_utc"})
    plan_path = plan_dir / f"{args.command}-{plan_hash}.json"

    plan_path.write_text(json.dumps(plan, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.chmod(plan_path, 0o600)
    summary = {"command": args.command, "mode": "dry-run", "plan_hash": plan_hash, "plan_path": str(plan_path), "operation_count": len(plan.get("operations", [])), "automatic_deletion": False}
    print(yaml.safe_dump(summary, sort_keys=True), end="")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        if os.environ.get("EDSYS_NETBOX_SYNC_DEBUG") == "1":
            raise
        raise SystemExit(1)
