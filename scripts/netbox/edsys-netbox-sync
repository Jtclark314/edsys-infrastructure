def canonical(value: Any) -> str:
    return json.dumps(
        value,
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=False,
        default=lambda item: item.isoformat() if isinstance(item, (dt.date, dt.datetime)) else str(item),
    )


def digest(value: Any) -> str:
    return hashlib.sha256(canonical(value).encode()).hexdigest()


def slug(value: str) -> str:
    cleaned = re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")
    return cleaned[:100] or "unnamed"


def source_hash(value: Any) -> str:
    return digest(value)


def ref(name: str) -> dict[str, str]:
    return {"$ref": name}


class NetBoxAPI:
    def __init__(self, base_url: str, token_file: str):
        self.base = base_url.rstrip("/") + "/api/"
        self.auth = Path(token_file).read_text(encoding="utf-8").strip()
        if not self.auth.startswith(("Bearer nbt_", "Token ")):
            raise RuntimeError("NetBox token file does not contain a supported authorization header")

    def request(self, method: str, path: str, payload=None, params=None):
        url = self.base + path.lstrip("/")
        if params:
            url += "?" + urlencode(params, doseq=True)
        data = None if payload is None else canonical(payload).encode()
        request = Request(
            url,
            data=data,
            method=method,
            headers={
                "Authorization": self.auth,
                "Accept": "application/json",
                "Content-Type": "application/json",
                "User-Agent": "edsys-netbox-sync/1.0",
            },
        )
        try:
            with urlopen(request, timeout=45) as response:
                body = response.read()
                return json.loads(body) if body else None
        except HTTPError as exc:
            body = exc.read().decode(errors="replace")
            raise RuntimeError(f"NetBox API {method} {url} failed: HTTP {exc.code}: {body[:2000]}") from exc

    def get(self, path: str, params=None):
        return self.request("GET", path, params=params)

    def list(self, path: str, params=None) -> list[dict[str, Any]]:
        params = dict(params or {})
        params.setdefault("limit", 1000)
        response = self.get(path, params=params)
        if isinstance(response, list):
            return response
        return response.get("results", [])

    def find_one(self, path: str, lookup: dict[str, Any]):
        matches = self.list(path, lookup)
        if len(matches) > 1:
            raise RuntimeError(f"Non-unique NetBox lookup for {path}: {lookup}")
        return matches[0] if matches else None

    def create(self, path: str, payload: dict[str, Any]):
        return self.request("POST", path, payload=payload)

    def patch(self, path: str, object_id: int, payload: dict[str, Any]):
        return self.request("PATCH", f"{path}{object_id}/", payload=payload)


class Plan:
    def __init__(self, command: str, evidence: dict[str, Any] | None = None):
        self.command = command
        self.evidence = evidence or {}
        self.operations: list[dict[str, Any]] = []

    def upsert(self, key: str, endpoint: str, lookup: dict[str, Any], payload: dict[str, Any]):
        self.operations.append(
            {
                "kind": "upsert",
                "key": key,
                "endpoint": endpoint,
                "lookup": lookup,
                "payload": payload,
            }
        )

    def patch_ref(self, key: str, target: str, payload: dict[str, Any]):
        self.operations.append({"kind": "patch-ref", "key": key, "target": target, "payload": payload})

    def reference(self, key: str, endpoint: str, lookup: dict[str, Any]):
        self.operations.append({"kind": "reference", "key": key, "endpoint": endpoint, "lookup": lookup})

    def as_dict(self):
        return {
            "schema": 1,
            "command": self.command,
            "created_utc": dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat(),
            "policy": {"automatic_deletion": False, "field_ownership": "observed facts only"},
            "evidence": self.evidence,
            "operations": self.operations,
        }


def resolve(value: Any, refs: dict[str, dict[str, Any]]):
    if isinstance(value, dict) and set(value) == {"$ref"}:
        try:
            return refs[value["$ref"]]["id"]
        except KeyError as exc:
            raise RuntimeError(f"Unresolved plan reference: {value['$ref']}") from exc
    if isinstance(value, dict):
        return {key: resolve(item, refs) for key, item in value.items()}
    if isinstance(value, list):
        return [resolve(item, refs) for item in value]
    return value


def normalize_compare(value: Any):
    if isinstance(value, dict):
        if "value" in value and set(value).issubset({"value", "label", "description"}):
            return value["value"]
        if "id" in value and any(key in value for key in ("name", "display", "slug", "address")):
            return value["id"]
        return {key: normalize_compare(item) for key, item in value.items()}
    if isinstance(value, list):
        return [normalize_compare(item) for item in value]
    return value


def values_match(existing: Any, desired: Any, key: str = "") -> bool:
    """Compare an API representation with the plan's writable representation.

    NetBox expands relationships, supplies unset custom fields as null, sorts
    some lists, normalizes MAC/IP values, and trims text.  Those presentation
    differences must not trigger perpetual PATCH requests.
    """
    existing = normalize_compare(existing)
    desired = normalize_compare(desired)
    if isinstance(desired, dict):
        if not isinstance(existing, dict):
            return False
        return all(values_match(existing.get(child), value, child) for child, value in desired.items())
    if isinstance(desired, list):
        if not isinstance(existing, list):
            return False
        left = [normalize_compare(item) for item in existing]
        right = [normalize_compare(item) for item in desired]
        return sorted(canonical(item) for item in left) == sorted(canonical(item) for item in right)
    if isinstance(existing, str) and isinstance(desired, str):
        left, right = existing.strip(), desired.strip()
        if key == "mac_address":
            return left.upper() == right.upper()
        if key in {"start_address", "end_address"}:
            return left.split("/", 1)[0] == right.split("/", 1)[0]
        return left == right
    if isinstance(existing, (int, float)) and isinstance(desired, str):
        try:
            return float(existing) == float(desired)
        except ValueError:
            pass
    return existing == desired


def execute_plan(api: NetBoxAPI, plan: dict[str, Any]):
    refs: dict[str, dict[str, Any]] = {}
    changes = {"created": 0, "updated": 0, "unchanged": 0}
    for operation in plan["operations"]:
        if operation["kind"] == "reference":
            lookup = resolve(operation["lookup"], refs)
            obj = api.find_one(operation["endpoint"], lookup)
            if obj is None:
                raise RuntimeError(f"Required NetBox reference is missing for {operation['key']}")
            refs[operation["key"]] = obj
            changes["unchanged"] += 1
        elif operation["kind"] == "upsert":
            lookup = resolve(operation["lookup"], refs)
            payload = resolve(operation["payload"], refs)
            existing = api.find_one(operation["endpoint"], lookup)
            if existing is None:
                obj = api.create(operation["endpoint"], payload)
                changes["created"] += 1
            else:
                needs_update = any(not values_match(existing.get(key), value, key) for key, value in payload.items())
                if needs_update:
                    obj = api.patch(operation["endpoint"], existing["id"], payload)
                    changes["updated"] += 1
                else:
                    obj = existing
                    changes["unchanged"] += 1
            refs[operation["key"]] = obj
        elif operation["kind"] == "patch-ref":
            target = refs.get(operation["target"])
            if not target:
                raise RuntimeError(f"Patch target is unavailable: {operation['target']}")
            payload = resolve(operation["payload"], refs)
            if any(not values_match(target.get(key), value, key) for key, value in payload.items()):
                obj = api.patch(target["url"].split("/api/", 1)[1].rsplit("/", 2)[0] + "/", target["id"], payload)
                refs[operation["target"]] = obj
                changes["updated"] += 1
            else:
                changes["unchanged"] += 1
    return changes


def cf_values(source: str, observed: str | None, confidence: str, raw: Any, **extra):
    result = {
        "source": source[:200],
        "last_observed": (observed or TODAY)[:10],
        "confidence": (confidence or "to be confirmed")[:100],
        "source_hash": source_hash(raw),
        "discovered": True,
        "authoritative": AUTHORITATIVE_CUTOVER,
        "retired": False,
    }
    result.update({key: value for key, value in extra.items() if value is not None})
    return result


def inventory_tags(
    *, to_be_confirmed: bool = False, benchmark_canary: bool = False, retired: bool = False
):
    result = [ref("tag:discovered")]
    if AUTHORITATIVE_CUTOVER:
        result.append(ref("tag:authoritative"))
    if to_be_confirmed:
        result.append(ref("tag:to-be-confirmed"))
    if benchmark_canary:
        result.append(ref("tag:benchmark-canary"))
    if retired:
        result.append(ref("tag:retired"))
    return result


