[Unit]
Description=Pull and verify the latest EdCore Automation application backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
TimeoutStartSec=20min
EnvironmentFile=-/etc/edsys-automation/backup-pull.env
EnvironmentFile=-/etc/edsys-healthchecks/edsys-edcore-automation-backup-pull.env
ExecStartPre=/usr/local/libexec/edsys-edcore-automation/validate-installed-pull.py
ExecStart=/usr/local/libexec/edsys-edcore-automation/pull-backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/etc/edsys-secrets/edcore-automation-backup
ReadWritePaths=/srv/edsys-backup/staging/edcore-automation
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
