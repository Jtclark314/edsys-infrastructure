    "unifi": {
      "kind": "unifi",
      "approved": false,
      "transport": "ssh",
      "ssh_target": "backup@controller-host.example.invalid",
      "expected_hostname": "REPLACE_HOSTNAME",
      "roots": [
        {
          "label": "configuration",
          "path": "/opt/unifi"
        }
      ],
      "mongo_data_roots": [
        "/opt/unifi/db",
        "/REPLACE_ANONYMOUS_CONFIGDB_PATH"
      ],
      "expected_container_images": {
        "REPLACE_CONTROLLER_CONTAINER": "sha256:REPLACE_CONTROLLER_IMAGE",
        "REPLACE_MONGO_CONTAINER": "sha256:REPLACE_MONGO_IMAGE"
      },
      "commands": [
        {
          "name": "controller-inspect",
          "argv": [
            "docker",
            "inspect",
            "REPLACE_CONTROLLER_CONTAINER"
          ]
        },
        {
          "name": "database-inspect",
          "argv": [
            "docker",
            "inspect",
            "REPLACE_MONGO_CONTAINER"
          ]
        },
        {
          "name": "software-images",
          "argv": [
            "docker",
            "image",
            "inspect",
            "REPLACE_CONTROLLER_IMAGE",
            "REPLACE_MONGO_IMAGE"
          ]
        }
      ],
      "native_export": {
        "approved": false,
        "location": "hub",
        "executable": "/usr/local/libexec/edsys-network-recovery/edsys-unifi-native-export.py",
        "sha256": "REPLACE_REVIEWED_EXPORTER_SHA256"
      },
      "native_backup_roots": [
