      ],
      "volatile_roots": [
        "/opt/unifi/config/logs",
        "/opt/unifi/config/data/log",
        "/opt/unifi/config/data/logs",
        "/opt/unifi/config/data/cache",
        "/opt/unifi/config/data/tmp",
        "/opt/unifi/config/tmp"
      ],
      "exclude_globs": [
        "/opt/unifi/config/hs_err_pid*",
        "/opt/unifi/config/replay_pid*",
        "/opt/unifi/config/core.*",
        "/opt/unifi/config/*.hprof*"
