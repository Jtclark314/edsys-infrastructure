[Unit]
Description=Forward the existing Immich LAN endpoint to 9950x
Requires=edsys-immich-legacy.socket
After=network-online.target

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd 192.168.50.50:2283
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
Restart=on-failure
RestartSec=5
