# Install only as root-owned mode 0600 at the runtime storage.env path.
# Substitute the independently verified filesystem UUIDs; never omit a value.
IMMICH_MEDIA_UUID=REPLACE_WITH_DEDICATED_PHOTO_FILESYSTEM_UUID
IMMICH_NVME_UUID=REPLACE_WITH_INTERNAL_STATE_FILESYSTEM_UUID
# Match the reviewed profile and existing initialized cluster. Current startup
# defaults to PG18; matched PG14 recovery must explicitly restore major14.
IMMICH_POSTGRES_MAJOR=18
