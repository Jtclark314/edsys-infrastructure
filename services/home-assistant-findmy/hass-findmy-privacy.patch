diff --git a/custom_components/findmy/coordinator.py b/custom_components/findmy/coordinator.py
index f5694b8..92d896f 100644
--- a/custom_components/findmy/coordinator.py
+++ b/custom_components/findmy/coordinator.py
@@ -235,0 +236,10 @@ class FindMyCoordinator(DataUpdateCoordinator[FindMyLocationData | None]):
+        except ValueError as err:
+            success = False
+            # FindMy tries to sign in again after an expired session receives
+            # HTTP 401. We intentionally persist no Apple password, so request
+            # interactive re-authentication instead of leaving the entry stale.
+            if str(err) == "No username or password specified":
+                raise ConfigEntryAuthFailed(
+                    "Apple session expired; sign in again",
+                ) from err
+            raise
