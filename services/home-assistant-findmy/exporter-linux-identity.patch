+    #[test]
+    fn account_and_cloudkit_adapters_keep_distinct_contexts_and_same_opaque_fields() {
+        let info = super::linux_login_info(synthetic_login_info());
+        let delegate = super::LinuxAnisetteProvider::new(
+            "http://helper.invalid".into(), info.clone(), "same-synthetic-state".into(), super::WINDOWS_DELEGATE_INFO.into(),
+        );
+        let cloudkit = super::LinuxAnisetteProvider::new(
+            "http://helper.invalid".into(), info, "same-synthetic-state".into(), "original-iPhone-context".into(),
+        );
+        let base = std::collections::HashMap::from([
+            ("X-Mme-Client-Info".into(), super::LINUX_CLIENT_INFO.into()),
+            ("X-Apple-I-MD-M".into(), "synthetic-machine".into()),
+            ("X-Apple-I-MD".into(), "synthetic-otp".into()),
+        ]);
+        let account = delegate.keychain_headers(base.clone());
+        let ck = cloudkit.keychain_headers(base);
+        assert_eq!(account["X-Mme-Client-Info"], super::WINDOWS_DELEGATE_INFO);
+        assert_eq!(ck["X-Mme-Client-Info"], "original-iPhone-context");
+        for key in ["X-Apple-I-MD-M", "X-Apple-I-MD"] { assert_eq!(account[key], ck[key]); }
+    }
