+    fn synthetic_login_info() -> omnisette::LoginClientInfo {
+        omnisette::LoginClientInfo {
+            ak_context_type: "imessage".into(), client_app_name: "Messages".into(),
+            client_bundle_id: "com.apple.MobileSMS".into(),
+            mme_client_info: "synthetic-iPhone-context".into(),
+            mme_client_info_akd: "synthetic-iPhone-akd".into(),
+            akd_user_agent: "synthetic-old-agent".into(), browser_user_agent: "old-browser".into(),
+            hardware_headers: std::collections::HashMap::from([("synthetic-hardware".into(), "private-placeholder".into())]),
+            push_token: None, update_account_bundle_id: "unchanged-update-context".into(),
+        }
+    }
+
+    #[test]
+    fn linux_identity_matches_adi_without_changing_service_capabilities() {
+        let info = super::linux_login_info(synthetic_login_info());
+        assert_eq!(info.mme_client_info_akd, super::LINUX_CLIENT_INFO);
+        assert_eq!(info.mme_client_info, super::LINUX_CLIENT_INFO);
+        assert_eq!(info.akd_user_agent, "akd/1.0 CFNetwork/808.1.4");
+        assert_eq!(info.browser_user_agent, info.akd_user_agent);
+        assert!(info.hardware_headers.is_empty());
+        assert_eq!(info.client_bundle_id, "com.apple.MobileSMS");
+        assert_eq!(info.update_account_bundle_id, "unchanged-update-context");
+    }
+
+    #[test]
+    fn keychain_adapter_preserves_every_opaque_authentication_field() {
+        let info = super::linux_login_info(synthetic_login_info());
+        let provider = super::LinuxAnisetteProvider::new(
+            "http://helper.invalid".into(), info, "unused-synthetic-state".into(), "synthetic-iPhone-context".into(),
+        );
+        let base = std::collections::HashMap::from([
+            ("X-Mme-Client-Info".into(), super::LINUX_CLIENT_INFO.into()),
+            ("X-Apple-I-MD-M".into(), "synthetic-machine".into()),
+            ("X-Apple-I-MD".into(), "synthetic-otp".into()),
+            ("X-Mme-Device-Id".into(), "synthetic-device".into()),
+        ]);
+        let actual = provider.keychain_headers(base.clone());
+        assert_eq!(actual.len(), base.len());
+        for (key, value) in base {
+            assert_eq!(actual[&key], if key == "X-Mme-Client-Info" { "synthetic-iPhone-context" } else { &value });
+        }
+    }
+
+    #[test]
+    fn gsa_real_header_composer_overrides_keychain_context_with_android() {
+        let info = super::linux_login_info(synthetic_login_info());
+        let data = icloud_auth::anisette::AnisetteData {
+            base_headers: std::collections::HashMap::from([
+                ("X-Mme-Client-Info".into(), "synthetic-iPhone-context".into()),
+                ("X-Apple-I-MD-M".into(), "synthetic-machine".into()),
+                ("X-Apple-I-MD".into(), "synthetic-otp".into()),
+            ]),
+            client_info: info,
+        };
+        for headers in [data.get_gsservice_headers(), data.get_extra_headers(), data.get_circle_headers()] {
+            assert_eq!(headers["X-MMe-Client-Info"], super::LINUX_CLIENT_INFO);
+            assert_eq!(headers["X-Apple-I-MD-M"], "synthetic-machine");
+            assert_eq!(headers["X-Apple-I-MD"], "synthetic-otp");
+        }
+        let cpd = data.get_cpd_data("synthetic-request");
+        assert!(!cpd.contains_key("synthetic-hardware"));
+        assert_eq!(cpd["cbid"].as_string(), Some("com.apple.MobileSMS"));
+    }
