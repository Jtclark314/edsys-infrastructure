+// Linux ADI libraries mint Android data. Keep GSA identity consistent with it,
+// while retaining the existing device profile for delegates/CloudKit/Keychain.
+const LINUX_CLIENT_INFO: &str = "<Pixel 7> <Android;14;UQ1A.240205.002> <com.apple.AuthKit/1 (com.apple.akd/1.0)>";
+
+fn linux_login_info(mut info: LoginClientInfo) -> LoginClientInfo {
+    info.mme_client_info = LINUX_CLIENT_INFO.into();
+    info.mme_client_info_akd = LINUX_CLIENT_INFO.into();
+    info.akd_user_agent = "akd/1.0 CFNetwork/808.1.4".into();
+    info.browser_user_agent = info.akd_user_agent.clone();
+    info.hardware_headers.clear();
+    info
+}
+
+struct LinuxAnisetteProvider {
+    inner: RemoteAnisetteProviderV3,
+    keychain_client_info: String,
+}
+
+impl LinuxAnisetteProvider {
+    fn new(url: String, login_info: LoginClientInfo, path: PathBuf, keychain_client_info: String) -> Self {
+        Self { inner: RemoteAnisetteProviderV3::new(url, login_info, path), keychain_client_info }
+    }
+
+    fn keychain_headers(&self, mut headers: HashMap<String, String>) -> HashMap<String, String> {
+        headers.insert("X-Mme-Client-Info".into(), self.keychain_client_info.clone());
+        headers
+    }
+}
+
+impl AnisetteProvider for LinuxAnisetteProvider {
+    async fn get_anisette_headers(&mut self) -> Result<HashMap<String, String>, AnisetteError> {
+        let headers = self.inner.get_anisette_headers().await?;
+        Ok(self.keychain_headers(headers))
+    }
+}
