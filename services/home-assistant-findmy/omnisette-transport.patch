+// The HTTP client uses http(s); the provisioning socket must use ws(s).
+fn provisioning_websocket_url(base: &str) -> Result<String, AnisetteError> {
+    let mut url = reqwest::Url::parse(base)
+        .map_err(|_| AnisetteError::InvalidArgument("Invalid anisette helper URL".into()))?;
+    let scheme = match url.scheme() {
+        "http" => "ws",
+        "https" => "wss",
+        _ => return Err(AnisetteError::InvalidArgument("Anisette helper must use HTTP or HTTPS".into())),
+    };
+    url.set_scheme(scheme)
+        .map_err(|_| AnisetteError::InvalidArgument("Invalid anisette WebSocket scheme".into()))?;
+    let path = format!("{}/v3/provisioning_session", url.path().trim_end_matches('/'));
+    url.set_path(&path);
+    url.set_fragment(None);
+    Ok(url.into())
+}
