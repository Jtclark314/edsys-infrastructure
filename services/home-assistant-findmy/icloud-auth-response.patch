+    async fn init_probe_is_one_shot_and_sanitizes_preparation_failure() {
+        use std::sync::atomic::{AtomicUsize, Ordering};
+        struct RefusingProvider(Arc<AtomicUsize>);
+        impl AnisetteProvider for RefusingProvider {
+            async fn get_anisette_headers(&mut self) -> Result<HashMap<String, String>, omnisette::AnisetteError> {
+                self.0.fetch_add(1, Ordering::SeqCst);
+                Err(omnisette::AnisetteError::InvalidArgument("private-preparation-marker".into()))
+            }
+            async fn get_2fa_code(&mut self) -> Result<u32, omnisette::AnisetteError> {
+                panic!("init probe must not request a verification code");
+            }
+        }
+        let calls = Arc::new(AtomicUsize::new(0));
+        let anisette = Arc::new(Mutex::new(AnisetteClient::new(RefusingProvider(calls.clone()))));
+        let mut account = AppleAccount::new_with_anisette(LoginClientInfo::default(), anisette).unwrap();
+        let error = account.probe_login_init("synthetic@example.invalid").await.unwrap_err();
+        assert!(matches!(error, Error::GsaTransport { stage: "SRP init preparation" }));
+        assert!(!format!("{error:?} {error}").contains("private-preparation-marker"));
+        assert_eq!(calls.load(Ordering::SeqCst), 1);
+        assert!(account.username.is_none());
+        assert!(account.hashed_password.is_none());
+        assert!(account.spd.is_none());
+        assert!(account.tokens.is_empty());
+    }
