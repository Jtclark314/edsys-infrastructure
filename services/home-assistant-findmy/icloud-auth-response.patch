+// Both full authentication and the one-shot init probe construct the same request.
+// The endpoint and operation are fixed here; this cannot construct a password proof.
+fn build_gsa_init_request(
+    client: &Client,
+    username: &str,
+    a_pub: Vec<u8>,
+    anisette: &AnisetteData,
+    request_id: &str,
+) -> Result<(Request, HeaderMap), Error> {
+    let mut headers = HeaderMap::new();
+    headers.insert("Content-Type", HeaderValue::from_static("text/x-xml-plist"));
+    headers.insert("Accept", HeaderValue::from_static("*/*"));
+    headers.extend(anisette.get_gsservice_headers().into_iter().map(|(a, b)| (
+        HeaderName::from_str(&a).unwrap(), HeaderValue::from_str(&b).unwrap(),
+    )));
+    let packet = InitRequest {
+        header: RequestHeader { version: "1.0.1".to_string() },
+        request: InitRequestBody {
+            a_pub: Value::Data(a_pub),
+            cpd: anisette.get_cpd_data(request_id),
+            operation: "init".to_string(),
+            ps: vec!["s2k".to_string(), "s2k_fo".to_string()],
+            username: username.to_string(),
+        },
+    };
+    let mut buffer = Vec::new();
+    plist::to_writer_xml(&mut buffer, &packet)
+        .map_err(|_| Error::GsaTransport { stage: "SRP init" })?;
+    let request = client.post(GSA_ENDPOINT).headers(headers.clone()).body(buffer).build()
+        .map_err(|_| Error::GsaTransport { stage: "SRP init" })?;
+    Ok((request, headers))
+}
