+fn check_protocol_error(response: &Dictionary) -> Result<(), Error> {
+    let status = match response.get("Status") {
+        Some(Value::Dictionary(status)) => status,
+        Some(_) => return Err(Error::Parse),
+        None => response,
+    };
+    let code = status.get("ec").and_then(Value::as_signed_integer).ok_or(Error::Parse)?;
+    if code != 0 {
+        return Err(Error::AuthSrpWithMessage(
+            code,
+            status.get("em").and_then(Value::as_string)
+                .unwrap_or("Apple authentication failed").to_owned(),
+        ));
+    }
+    Ok(())
+}
+
+fn decode_gsa_plist(http_status: u16, body: &[u8], stage: &'static str) -> Result<Dictionary, Error> {
+    let failure = |kind| Error::GsaResponse { stage, http_status, kind };
+    // Deserializer errors can contain response text. Never expose the body through them.
+    let root: Value = plist::from_bytes(body).map_err(|_| {
+        let prefix = body.iter().copied().skip_while(u8::is_ascii_whitespace)
+            .take(16).map(|byte| byte.to_ascii_lowercase()).collect::<Vec<_>>();
+        failure(if prefix.starts_with(b"<html") || prefix.starts_with(b"<!doctype html") {
+            "HTML response instead of a GrandSlam plist"
+        } else {
+            "invalid GrandSlam plist"
+        })
+    })?;
+    root.into_dictionary().ok_or_else(|| failure("invalid GrandSlam response map"))
+}
+
+fn decode_gsa_response(http_status: u16, body: &[u8], stage: &'static str) -> Result<Dictionary, Error> {
+    let failure = |kind| Error::GsaResponse { stage, http_status, kind };
+    let root = decode_gsa_plist(http_status, body, stage)?;
+    let response = match root.get("Response") {
+        Some(Value::Dictionary(response)) => response,
+        Some(_) => return Err(failure("invalid GrandSlam response map")),
+        None => {
+            // Apple sometimes sends a structured error without the Response wrapper.
+            if let Err(error @ Error::AuthSrpWithMessage(_, _)) = check_protocol_error(&root) {
+                return Err(error);
+            }
+            return Err(failure("missing GrandSlam response map"));
+        }
+    };
+    check_protocol_error(response).map_err(|error| match error {
+        Error::Parse => failure("missing or invalid GrandSlam status code"),
+        other => other,
+    })?;
+    if !(200..300).contains(&http_status) {
+        return Err(failure("unsuccessful GrandSlam HTTP response"));
+    }
+    Ok(response.clone())
+}
+
+fn decode_gsa_validation_response(http_status: u16, body: &[u8]) -> Result<Dictionary, Error> {
+    const STAGE: &str = "trusted-device verification";
+    let response = decode_gsa_plist(http_status, body, STAGE)?;
+    check_protocol_error(&response).map_err(|error| match error {
+        Error::Parse => Error::GsaResponse {
+            stage: STAGE, http_status, kind: "missing or invalid GrandSlam status code",
+        },
+        other => other,
+    })?;
+    if !(200..300).contains(&http_status) {
+        return Err(Error::GsaResponse {
+            stage: STAGE, http_status, kind: "unsuccessful GrandSlam HTTP response",
+        });
+    }
+    Ok(response)
+}
+
+fn check_sms_verification_http(http_status: u16) -> Result<(), Error> {
+    if http_status != 200 {
+        return Err(Error::Bad2faCode);
+    }
+    Ok(())
+}
+
+async fn parse_response(res: Result<Response, reqwest::Error>, stage: &'static str) -> Result<Dictionary, Error> {
+    let res = res.map_err(|_| Error::GsaTransport { stage })?;
+    let http_status = res.status().as_u16();
+    let body = res.bytes().await.map_err(|_| Error::GsaTransport { stage })?;
+    decode_gsa_response(http_status, &body, stage)
+}
