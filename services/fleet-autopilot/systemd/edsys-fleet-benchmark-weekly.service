[Unit]
Description=EdSys Fleet weekly real Codex Ultra capability benchmark
After=network-online.target docker.service edsys-codex-app-server.service
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/edsys-fleet benchmark --suite ultra --host 9950x --triggered-by systemd-weekly
TimeoutStartSec=2h
