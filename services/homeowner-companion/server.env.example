# Substitute the exact home LAN address and existing Tailnet DNS name.
# Store the deployed file privately at ~/.config/homeowner-companion/server.env.
COMPANION_BIND_ADDRESSES=127.0.0.1,192.168.50.50
COMPANION_PORT=8126
COMPANION_ORIGINS=http://127.0.0.1:8126,http://localhost:8126,http://192.168.50.50:8126,https://YOUR-HOST.YOUR-TAILNET.ts.net:8447
COMPANION_CLIENT_NETWORKS=127.0.0.0/8,::1/128,192.168.50.0/24,100.64.0.0/10,fd7a:115c:a1e0::/48
