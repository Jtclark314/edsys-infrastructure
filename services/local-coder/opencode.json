{
  "$schema": "https://opencode.ai/config.json",
  "model": "edsys-local/edsys-qwen36-coder:latest",
  "small_model": "edsys-local/edsys-qwen36-coder:latest",
  "enabled_providers": [
    "edsys-local"
  ],
  "share": "disabled",
  "autoupdate": false,
  "plugin": [
    "file:///srv/edsys/edsys-infrastructure/services/local-coder/context-plugin.mjs"
  ],
  "instructions": [
    "/srv/edsys/edsys-infrastructure/services/local-coder/AGENT_RULES.md",
    "/home/jeremy/code/EdSys-Master/docs/context-packs/LOCAL_CODER_STARTUP.md"
  ],
  "provider": {
    "edsys-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "EdSys local Qwen3.6 coder",
      "options": {
        "baseURL": "http://127.0.0.1:11435/v1",
        "timeout": 1800000,
        "headerTimeout": 1800000,
        "chunkTimeout": 1800000
      },
      "models": {
        "edsys-qwen36-coder:latest": {
          "name": "Qwen3.6 35B A3B Q8 (local)",
          "reasoning": true,
          "tool_call": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 65536,
            "output": 16384
          },
          "options": {
            "temperature": 0.6,
            "topP": 0.95
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": true
        }
      }
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": "allow",
    "bash": "allow",
    "external_directory": "allow",
    "edsys_*": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "task": "allow",
    "browser_*": "ask",
    "desktop_*": "ask",
    "desktop_desktop_screenshot": "allow"
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "agent": {
    "build": {
      "steps": 40
    },
    "plan": {
      "steps": 20
    },
    "general": {
      "steps": 20,
      "model": "edsys-local/edsys-qwen36-coder:latest",
      "permission": {
        "edsys_save_checkpoint": "deny"
      },
      "prompt": "You are a delegated local EdSys agent. The reviewed hook supplies this worktree guidance and checkpoint automatically on every model turn. Use edsys_session_context if an explicit refresh is needed; report missing automatic context before proceeding. Follow the shared EdSys startup briefing and AGENT_RULES. You are not alone: preserve other work. Cite only exact source paths returned by tools or actually provided in your instructions; never construct an unverified citation path. Do not save shared project checkpoints; return concise results, evidence and limitations to the parent. Work only on the bounded task assigned by the parent."
    },
    "explore": {
      "steps": 20,
      "model": "edsys-local/edsys-qwen36-coder:latest",
      "permission": {
        "edsys_save_checkpoint": "deny",
        "edit": "deny"
      },
      "prompt": "You are a delegated local EdSys agent. The reviewed hook supplies this worktree guidance and checkpoint automatically on every model turn. Use edsys_session_context if an explicit refresh is needed; report missing automatic context before proceeding. Follow the shared EdSys startup briefing and AGENT_RULES. You are not alone: preserve other work. Cite only exact source paths returned by tools or actually provided in your instructions; never construct an unverified citation path. Do not save shared project checkpoints; return concise results, evidence and limitations to the parent. Your assignment is read-only exploration. Do not edit files or run mutating commands. Use specific record queries or source reads and return the findings."
    }
  },
  "mcp": {
    "edsys": {
      "type": "local",
      "command": [
        "/mnt/ai-store/apps/local-coder/desktop-venv/bin/python",
        "/srv/edsys/edsys-infrastructure/services/local-coder/knowledge_mcp.py"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "browser": {
      "type": "local",
      "command": [
        "/mnt/ai-store/apps/local-coder/opencode-1.18.31/node_modules/.bin/playwright-mcp",
        "--browser",
        "chrome",
        "--headless",
        "--isolated",
        "--caps",
        "vision",
        "--output-dir",
        "/mnt/ai-store/local-coder/browser-output"
      ],
      "enabled": true,
      "timeout": 120000
    },
    "desktop": {
      "type": "local",
      "command": [
        "/srv/edsys/edsys-infrastructure/services/local-coder/desktop-mcp.sh"
      ],
      "enabled": true,
      "timeout": 30000
    }
  },
  "subagent_depth": 1
}
